# ── harness_live_bench environment config ────────────────────────────────────
# Copy to .env and fill in values.

# Port to host the mirrored page on during benchmarking
PORT=4000

# Device to measure post-agent CWV on (mobile|desktop)
DEVICE=desktop

# Number of Lighthouse runs for the post-agent measurement
NUM_RUNS=5

# Number of Lighthouse runs for the PRE-AGENT synthetic baseline measurement
BASELINE_RUNS=3

# Absolute (or relative to this file) path to the live_assets_eds mirror root
# e.g. MIRRORS_ROOT=../live_assets_eds
MIRRORS_ROOT=../live_assets_eds

# Agent API keys (uncomment/set what you need)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Claude model override (default: sonnet)
# CLAUDE_MODEL=claude-sonnet-4-5
